+  });
+
+  // Save vault path on input change
+  vaultPathInput.addEventListener('change', () => {
+    const path = vaultPathInput.value.trim();
+    if (path) {
+      chrome.storage.local.set({ obsidianVaultPath: path });
+    }
+  });
+
+  // Sync button handler
+  syncToBridgeBtn.addEventListener('click', async () => {
+    const vaultPath = vaultPathInput.value.trim();
+    if (!vaultPath) {
+      bridgeStatus.textContent = '❌ 请先填写 Obsidian vault 路径';
+      bridgeStatus.style.color = '#ef4444';
+      return;
+    }
+
+    bridgeStatus.textContent = '⏳ 正在同步...';
+    bridgeStatus.style.color = '#3b82f6';
+    syncToBridgeBtn.disabled = true;
+
+    try {
+      // Dynamic import to load lib modules
+      const [{ collectAndSync }, bridgeClient] = await Promise.all([
+        import('./lib/storage-collector.js'),
+        import('./lib/bridge-client.js'),
+      ]);
+
+      // First check bridge health
+      const health = await bridgeClient.checkBridgeHealth();
+      if (!health.ok) {
+        bridgeStatus.textContent = `⚠️ bridge 不可达 (${health.error}),降级到本地下载`;
+        bridgeStatus.style.color = '#f59e0b';
+      }
+
+      const result = await collectAndSync({ vaultPath });
+
+      if (result.mode === 'online') {
+        const synced = result.response.curated?.length || result.collectedCount;
+        bridgeStatus.textContent = `✅ 已同步 ${synced} 张卡片`;
+        bridgeStatus.style.color = '#10b981';
+      } else if (result.mode === 'offline_fallback') {
+        bridgeStatus.textContent = `📥 bridge 不可达,已下载 ${result.offlinePath},请手动拖入 Obsidian`;
+        bridgeStatus.style.color = '#f59e0b';
+      } else {
+        bridgeStatus.textContent = `❌ ${result.error || '同步失败'}`;
+        bridgeStatus.style.color = '#ef4444';
+      }
+
+      // Save last sync time
+      chrome.storage.local.set({ lastSyncTime: Date.now() });
+    } catch (err) {
+      bridgeStatus.textContent = `❌ 错误: ${err.message}`;
+      bridgeStatus.style.color = '#ef4444';
+    } finally {
+      syncToBridgeBtn.disabled = false;
+    }
+  });
